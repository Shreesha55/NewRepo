@{
    ViewData["Title"] = "Add Compliance Record";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="separator">/</span>
        <a asp-controller="Compliance" asp-action="Index">Compliance</a>
        <span class="separator">/</span>
        <span>Create</span>
    </div>
    <h2><i class="bi bi-plus-circle me-2"></i>Add Compliance Record</h2>
    <p>Schedule a new compliance inspection.</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-clipboard2-check me-2 text-primary"></i>Inspection Details</h5>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-controller="Compliance" asp-action="Create">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Business Name</label>
                        <input type="text" name="BusinessName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Inspection Type</label>
                        <select name="InspectionType" class="form-select" required>
                            <option value="">-- Select Type --</option>
                            <option value="Annual Audit">Annual Audit</option>
                            <option value="Safety Inspection">Safety Inspection</option>
                            <option value="License Compliance">License Compliance</option>
                            <option value="Tax Compliance">Tax Compliance</option>
                            <option value="Environmental Check">Environmental Check</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Inspection Date</label>
                        <input type="date" name="InspectedDate" class="form-control" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-tn-primary"><i class="bi bi-check-circle me-1"></i> Submit</button>
                        <a asp-controller="Compliance" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
