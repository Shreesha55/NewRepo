@{
    ViewData["Title"] = "Add Market Record";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="separator">/</span>
        <a asp-controller="MarketRecord" asp-action="Index">Markets</a>
        <span class="separator">/</span>
        <span>Create</span>
    </div>
    <h2><i class="bi bi-plus-circle me-2"></i>Add New Market Record</h2>
    <p>Register a new trade market.</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-shop me-2 text-primary"></i>Market Details</h5>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-controller="MarketRecord" asp-action="Create">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Market Name</label>
                        <input type="text" name="MarketName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Location</label>
                        <input type="text" name="Location" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Total Vendors</label>
                        <input type="number" name="TotalVendors" class="form-control" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Category</label>
                        <select name="Category" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            <option value="Wholesale">Wholesale</option>
                            <option value="Retail">Retail</option>
                            <option value="Import">Import</option>
                            <option value="Export">Export</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Revenue ($)</label>
                        <input type="number" name="Revenue" class="form-control" step="0.01" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Status</label>
                        <select name="Status" class="form-select" required>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Under Review">Under Review</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-tn-primary"><i class="bi bi-check-circle me-1"></i> Submit</button>
                        <a asp-controller="MarketRecord" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
