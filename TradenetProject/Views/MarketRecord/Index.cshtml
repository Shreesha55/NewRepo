@model List<TradeNetProject.Models.MarketRecord>

@{
    ViewData["Title"] = "Market Records";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="separator">/</span>
        <span>Market Records</span>
    </div>
    <h2><i class="bi bi-shop me-2"></i>Market Records</h2>
    <p>Browse registered trade markets, vendor statistics, and revenue reports.</p>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-icon text-primary"><i class="bi bi-shop-window"></i></div>
            <div class="stat-value">@Model.Count</div>
            <div class="stat-label">Total Markets</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-icon text-success"><i class="bi bi-check2-circle"></i></div>
            <div class="stat-value">@Model.Count(m => m.Status == "Active")</div>
            <div class="stat-label">Active Markets</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-icon text-info"><i class="bi bi-people"></i></div>
            <div class="stat-value">@Model.Sum(m => m.TotalVendors)</div>
            <div class="stat-label">Total Vendors</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-icon text-warning"><i class="bi bi-currency-dollar"></i></div>
            <div class="stat-value">$@Model.Sum(m => m.Revenue).ToString("N0")</div>
            <div class="stat-label">Total Revenue</div>
        </div>
    </div>
</div>

<div class="table-container">
    <div class="p-3 d-flex justify-content-between align-items-center border-bottom">
        <h5 class="mb-0 fw-bold"><i class="bi bi-table me-2"></i>All Market Records</h5>
    </div>
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Market Name</th>
                <th scope="col">Location</th>
                <th scope="col">Category</th>
                <th scope="col">Vendors</th>
                <th scope="col">Revenue</th>
                <th scope="col">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td><strong>@m.RecordID</strong></td>
                    <td>
                        <i class="bi bi-shop me-1 text-muted"></i>
                        @m.MarketName
                    </td>
                    <td>
                        <i class="bi bi-geo-alt me-1 text-muted"></i>
                        @m.Location
                    </td>
                    <td>
                        <span class="badge badge-status badge-@m.Category.ToLower()">
                            @m.Category
                        </span>
                    </td>
                    <td>
                        <i class="bi bi-people me-1 text-muted"></i>
                        @m.TotalVendors
                    </td>
                    <td>
                        <span class="amount-value">$@m.Revenue.ToString("N2")</span>
                    </td>
                    <td>
                        <span class="badge badge-status badge-@m.Status.ToLower().Replace(" ", "-")">
                            @if (m.Status == "Active")
                            {
                                <i class="bi bi-check-circle-fill me-1"></i>
                            }
                            else if (m.Status == "Inactive")
                            {
                                <i class="bi bi-dash-circle-fill me-1"></i>
                            }
                            else
                            {
                                <i class="bi bi-clock-fill me-1"></i>
                            }
                            @m.Status
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
