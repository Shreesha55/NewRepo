@model TradeNetProject.Models.Document

@{
    ViewData["Title"] = "Edit Document";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="separator">/</span>
        <a asp-controller="Document" asp-action="Index">Documents</a>
        <span class="separator">/</span>
        <span>Edit #@Model.DocumentID</span>
    </div>
    <h2><i class="bi bi-pencil-square me-2"></i>Edit Document</h2>
    <p>Modify document details.</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-medical me-2 text-primary"></i>Document Details</h5>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-controller="Document" asp-action="Edit">
                    <input type="hidden" name="DocumentID" value="@Model.DocumentID" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Business Name</label>
                        <input type="text" name="BusinessName" class="form-control" value="@Model.BusinessName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Document Type</label>
                        <select name="DocumentType" class="form-select" required>
                            <option value="Trade Certificate" selected="@(Model.DocumentType == "Trade Certificate")">Trade Certificate</option>
                            <option value="Tax Clearance" selected="@(Model.DocumentType == "Tax Clearance")">Tax Clearance</option>
                            <option value="Import Permit" selected="@(Model.DocumentType == "Import Permit")">Import Permit</option>
                            <option value="Export License" selected="@(Model.DocumentType == "Export License")">Export License</option>
                            <option value="Business Registration" selected="@(Model.DocumentType == "Business Registration")">Business Registration</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Submitted Date</label>
                        <input type="text" name="SubmittedDate" class="form-control" value="@Model.SubmittedDate" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Status</label>
                        <select name="Status" class="form-select">
                            <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                            <option value="Verified" selected="@(Model.Status == "Verified")">Verified</option>
                            <option value="Rejected" selected="@(Model.Status == "Rejected")">Rejected</option>
                        </select>
                    </div>
                    <input type="hidden" name="VerifiedBy" value="@Model.VerifiedBy" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-tn-primary"><i class="bi bi-check-circle me-1"></i> Save Changes</button>
                        <a asp-controller="Document" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
