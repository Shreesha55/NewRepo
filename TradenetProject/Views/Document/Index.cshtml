@model List<TradeNetProject.Models.Document>

@{
    ViewData["Title"] = "Document Verification";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="separator">/</span>
        <span>Document Verification</span>
    </div>
    <h2><i class="bi bi-file-earmark-medical me-2"></i>Document Verification</h2>
    <p>Review and verify business documents submitted for compliance and trade licensing.</p>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-icon text-primary"><i class="bi bi-files"></i></div>
            <div class="stat-value">@Model.Count</div>
            <div class="stat-label">Total Documents</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-icon text-warning"><i class="bi bi-hourglass-split"></i></div>
            <div class="stat-value">@Model.Count(d => d.Status == "Pending")</div>
            <div class="stat-label">Pending Review</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-icon text-success"><i class="bi bi-patch-check"></i></div>
            <div class="stat-value">@Model.Count(d => d.Status == "Verified")</div>
            <div class="stat-label">Verified</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-icon text-danger"><i class="bi bi-x-octagon"></i></div>
            <div class="stat-value">@Model.Count(d => d.Status == "Rejected")</div>
            <div class="stat-label">Rejected</div>
        </div>
    </div>
</div>

<div class="table-container">
    <div class="p-3 d-flex justify-content-between align-items-center border-bottom">
        <h5 class="mb-0 fw-bold"><i class="bi bi-table me-2"></i>All Documents</h5>
    </div>
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Business Name</th>
                <th scope="col">Document Type</th>
                <th scope="col">Submitted</th>
                <th scope="col">Verified By</th>
                <th scope="col">Status</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td><strong>@d.DocumentID</strong></td>
                    <td>
                        <i class="bi bi-building me-1 text-muted"></i>
                        @d.BusinessName
                    </td>
                    <td>
                        <i class="bi bi-file-earmark-text me-1 text-muted"></i>
                        @d.DocumentType
                    </td>
                    <td>
                        <i class="bi bi-calendar-event me-1 text-muted"></i>
                        @d.SubmittedDate
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(d.VerifiedBy))
                        {
                            <i class="bi bi-person-check me-1 text-muted"></i>
                            @d.VerifiedBy
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Awaiting review</span>
                        }
                    </td>
                    <td>
                        <span class="badge badge-status badge-@d.Status.ToLower().Replace(" ", "-")">
                            @if (d.Status == "Verified")
                            {
                                <i class="bi bi-check-circle-fill me-1"></i>
                            }
                            else if (d.Status == "Rejected")
                            {
                                <i class="bi bi-x-circle-fill me-1"></i>
                            }
                            else
                            {
                                <i class="bi bi-clock-fill me-1"></i>
                            }
                            @d.Status
                        </span>
                    </td>
                    <td>
                        @if (d.Status == "Pending")
                        {
                            <a asp-controller="Document" asp-action="Verify" asp-route-id="@d.DocumentID"
                               class="btn btn-sm btn-tn-primary">
                                <i class="bi bi-eye me-1"></i> Review
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small">No action needed</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
