@{
    ViewData["Title"] = "Add Document";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="separator">/</span>
        <a asp-controller="Document" asp-action="Index">Documents</a>
        <span class="separator">/</span>
        <span>Create</span>
    </div>
    <h2><i class="bi bi-plus-circle me-2"></i>Add New Document</h2>
    <p>Submit a new document for verification.</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-medical me-2 text-primary"></i>Document Details</h5>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-controller="Document" asp-action="Create">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Business Name</label>
                        <input type="text" name="BusinessName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Document Type</label>
                        <select name="DocumentType" class="form-select" required>
                            <option value="">-- Select Type --</option>
                            <option value="Trade Certificate">Trade Certificate</option>
                            <option value="Tax Clearance">Tax Clearance</option>
                            <option value="Import Permit">Import Permit</option>
                            <option value="Export License">Export License</option>
                            <option value="Business Registration">Business Registration</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Submitted Date</label>
                        <input type="date" name="SubmittedDate" class="form-control" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-tn-primary"><i class="bi bi-check-circle me-1"></i> Submit</button>
                        <a asp-controller="Document" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
