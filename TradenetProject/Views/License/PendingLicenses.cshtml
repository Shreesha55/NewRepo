@model List<TradeNetProject.Models.TradeLicense>

@{
    ViewData["Title"] = "Pending Licenses";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="separator">/</span>
        <a asp-controller="TradeOfficer" asp-action="Dashboard">Dashboard</a>
        <span class="separator">/</span>
        <span>Pending Licenses</span>
    </div>
    <h2><i class="bi bi-file-earmark-check me-2"></i>License Applications</h2>
    <p>Review and process submitted trade license applications.</p>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card stat-card">
            <div class="stat-icon text-primary"><i class="bi bi-files"></i></div>
            <div class="stat-value">@Model.Count</div>
            <div class="stat-label">Total Applications</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card">
            <div class="stat-icon text-warning"><i class="bi bi-hourglass-split"></i></div>
            <div class="stat-value">@Model.Count(l => l.Status == "Pending")</div>
            <div class="stat-label">Pending Review</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card">
            <div class="stat-icon text-success"><i class="bi bi-patch-check"></i></div>
            <div class="stat-value">@Model.Count(l => l.Status == "Approved")</div>
            <div class="stat-label">Approved</div>
        </div>
    </div>
</div>

<div class="table-container">
    <div class="p-3 d-flex justify-content-between align-items-center border-bottom">
        <h5 class="mb-0 fw-bold"><i class="bi bi-table me-2"></i>All License Applications</h5>
    </div>
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Business Name</th>
                <th scope="col">License Type</th>
                <th scope="col">Status</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.LicenseID</strong></td>
                    <td>
                        <i class="bi bi-building me-1 text-muted"></i>
                        @item.BusinessName
                    </td>
                    <td>
                        <span class="badge badge-status badge-@item.Type.ToLower()">
                            @item.Type
                        </span>
                    </td>
                    <td>
                        <span class="badge badge-status badge-@item.Status.ToLower()">
                            @item.Status
                        </span>
                    </td>
                    <td>
                        @if (item.Status == "Pending")
                        {
                            <a asp-controller="License" asp-action="Review" asp-route-id="@item.LicenseID"
                               class="btn btn-sm btn-tn-primary">
                                <i class="bi bi-eye me-1"></i> Review
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small">No action needed</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>