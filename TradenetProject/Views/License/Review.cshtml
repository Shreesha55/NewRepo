@model TradeNetProject.Models.TradeLicense

@{
    ViewData["Title"] = "Review License";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="separator">/</span>
        <a asp-controller="License" asp-action="PendingLicenses">Licenses</a>
        <span class="separator">/</span>
        <span>Review </span>
    </div>
    <h2><i class="bi bi-search me-2"></i>Review License Application</h2>
    <p>Examine the application details and approve or reject this license request.</p>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-info-circle me-2 text-primary"></i>Application Details
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="detail-row">
                    <div class="detail-label">License ID</div>
                    <div class="detail-value"><strong>#@Model.LicenseID</strong></div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Business</div>
                    <div class="detail-value">
                        <i class="bi bi-building me-1 text-muted"></i>
                        @Model.BusinessName
                    </div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">License Type</div>
                    <div class="detail-value">
                        <span class="badge badge-status badge-@Model.Type.ToLower()">@Model.Type</span>
                    </div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Current Status</div>
                    <div class="detail-value">
                        <span class="badge badge-status badge-@Model.Status.ToLower()">@Model.Status</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-hand-thumbs-up me-2 text-primary"></i>Decision
                </h5>
            </div>
            <div class="card-body p-4 text-center">
                <p class="text-muted mb-4">Choose an action for this license application.</p>

                <div class="d-grid gap-3">
                    <form method="post" asp-controller="License" asp-action="Approve" asp-route-id="@Model.LicenseID">
                        <button type="submit" class="btn btn-approve w-100 py-2">
                            <i class="bi bi-check-circle me-2"></i> Approve License
                        </button>
                    </form>

                    <form method="post" asp-controller="License" asp-action="Reject" asp-route-id="@Model.LicenseID">
                        <button type="submit" class="btn btn-reject w-100 py-2">
                            <i class="bi bi-x-circle me-2"></i> Reject License
                        </button>
                    </form>
                </div>

                <a asp-controller="License" asp-action="PendingLicenses" class="btn btn-outline-secondary mt-3">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>
 