@model TradeNetProject.Models.Transaction

@{
    ViewData["Title"] = "Edit Transaction";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="separator">/</span>
        <a asp-controller="Transaction" asp-action="Index">Transactions</a>
        <span class="separator">/</span>
        <span>Edit #@Model.TransactionID</span>
    </div>
    <h2><i class="bi bi-pencil-square me-2"></i>Edit Transaction</h2>
    <p>Modify transaction details.</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-receipt me-2 text-primary"></i>Transaction Details</h5>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-controller="Transaction" asp-action="Edit">
                    <input type="hidden" name="TransactionID" value="@Model.TransactionID" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Business Name</label>
                        <input type="text" name="BusinessName" class="form-control" value="@Model.BusinessName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Type</label>
                        <select name="Type" class="form-select" required>
                            <option value="Sale" selected="@(Model.Type == "Sale")">Sale</option>
                            <option value="Purchase" selected="@(Model.Type == "Purchase")">Purchase</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Amount ($)</label>
                        <input type="number" name="Amount" class="form-control" value="@Model.Amount" step="0.01" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Status</label>
                        <select name="Status" class="form-select">
                            <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                            <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-tn-primary"><i class="bi bi-check-circle me-1"></i> Save Changes</button>
                        <a asp-controller="Transaction" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
