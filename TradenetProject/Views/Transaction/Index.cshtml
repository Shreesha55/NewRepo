@model List<TradeNetProject.Models.Transaction>

@{
    ViewData["Title"] = "Transactions";
}

<div class="page-header">
    <div class="breadcrumb-custom">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="separator">/</span>
        <span>Transactions</span>
    </div>
    <h2><i class="bi bi-receipt me-2"></i>Transaction Records</h2>
    <p>View and monitor all trade transactions across registered businesses.</p>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-icon text-primary"><i class="bi bi-list-check"></i></div>
            <div class="stat-value">@Model.Count</div>
            <div class="stat-label">Total Transactions</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-icon text-success"><i class="bi bi-check-circle"></i></div>
            <div class="stat-value">@Model.Count(t => t.Status == "Completed")</div>
            <div class="stat-label">Completed</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-icon text-warning"><i class="bi bi-hourglass-split"></i></div>
            <div class="stat-value">@Model.Count(t => t.Status == "Pending")</div>
            <div class="stat-label">Pending</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-icon text-info"><i class="bi bi-currency-dollar"></i></div>
            <div class="stat-value">@Model.Sum(t => t.Amount).ToString("N0")</div>
            <div class="stat-label">Total Value</div>
        </div>
    </div>
</div>

<div class="table-container">
    <div class="p-3 d-flex justify-content-between align-items-center border-bottom">
        <h5 class="mb-0 fw-bold"><i class="bi bi-table me-2"></i>All Transactions</h5>
    </div>
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Business Name</th>
                <th scope="col">Type</th>
                <th scope="col">Amount</th>
                <th scope="col">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td><strong>@t.TransactionID</strong></td>
                    <td>
                        <i class="bi bi-building me-1 text-muted"></i>
                        @t.BusinessName
                    </td>
                    <td>
                        <span class="badge badge-status badge-@t.Type.ToLower()">
                            @t.Type
                        </span>
                    </td>
                    <td>
                        <span class="amount-value">$@t.Amount.ToString("N2")</span>
                    </td>
                    <td>
                        <span class="badge badge-status badge-@t.Status.ToLower()">
                            <i class="bi bi-@(t.Status == "Completed" ? "check-circle-fill" : "clock-fill") me-1"></i>
                            @t.Status
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
 