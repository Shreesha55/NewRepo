<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TradeNet Portal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TradenetProject.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Left Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-globe-americas sidebar-brand-icon"></i>
            <div>
                <strong class="sidebar-brand-title">TradeNet</strong>
                <small class="sidebar-brand-subtitle">Trade &amp; Compliance</small>
            </div>
        </div>

        <nav class="sidebar-nav">
            <span class="sidebar-nav-label">Main</span>
            <a class="sidebar-link" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door"></i><span>Home</span>
            </a>
            <a class="sidebar-link" asp-controller="TradeOfficer" asp-action="Dashboard">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>

            <span class="sidebar-nav-label">Management</span>
            <a class="sidebar-link" asp-controller="License" asp-action="PendingLicenses">
                <i class="bi bi-file-earmark-check"></i><span>Licenses</span>
            </a>
            <a class="sidebar-link" asp-controller="Transaction" asp-action="Index">
                <i class="bi bi-receipt"></i><span>Transactions</span>
            </a>
            <a class="sidebar-link" asp-controller="Document" asp-action="Index">
                <i class="bi bi-file-earmark-medical"></i><span>Documents</span>
            </a>

            <span class="sidebar-nav-label">Records</span>
            <a class="sidebar-link" asp-controller="MarketRecord" asp-action="Index">
                <i class="bi bi-shop"></i><span>Markets</span>
            </a>
            <a class="sidebar-link" asp-controller="Compliance" asp-action="Index">
                <i class="bi bi-clipboard2-check"></i><span>Compliance</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <i class="bi bi-envelope me-1"></i> contact&#64;tradenet.gov
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="main-wrapper">
        <!-- Top Header Bar -->
        <header class="top-header">
            <div class="top-header-left">
                <button class="sidebar-toggle-btn" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>
                <span class="top-header-title d-none d-md-inline">
                    <i class="bi bi-globe-americas me-1 text-primary"></i> TradeNet Portal
                </span>
            </div>
            <div class="top-header-right">
                <div class="dropdown">
                    <a class="profile-trigger" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="profile-trigger-avatar">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        <div class="profile-trigger-info d-none d-md-block">
                            <strong>Trade Officer</strong>
                            <small>Senior Trade Officer</small>
                        </div>
                        <i class="bi bi-chevron-down ms-1 d-none d-md-inline"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end profile-dropdown">
                        <li class="dropdown-header">
                            <div class="fw-bold">Trade Officer</div>
                            <small class="text-muted">Senior Trade Officer</small>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a class="dropdown-item" asp-controller="TradeOfficer" asp-action="Profile">
                                <i class="bi bi-person-badge me-2"></i> My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="TradeOfficer" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-2"></i> Dashboard
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="main-content">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="site-footer">
            <div class="d-flex flex-wrap justify-content-between align-items-center small">
                <span>&copy; 2026 TradeNet Portal. All rights reserved.</span>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('sidebarToggle').addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('collapsed');
            document.querySelector('.main-wrapper').classList.toggle('sidebar-collapsed');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
